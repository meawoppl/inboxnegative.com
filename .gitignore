# Generated by Cargo
# will have compiled files and executables
backend/target/
backend/debug/

frontend/target/
frontend/debug/
frontend/dist/


# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Added by cargo

/target

# Private keys and sensitive files
*.pem
*.key
*.cert

# Environment files with secrets. The glob covers stray variants like
# test.env, which the bare `.env` entries missed -- those sit untracked in
# working trees and would be captured by any non-git-aware copy of the tree.
# `.env.example` does not end in `.env`, so it stays tracked.
*.env
backend/.env
.env

# Test/development files
email.txt
aws-cli.sh
setup_aws.sh

# IDE settings
.vscode/

# CI build artifacts (assembled before docker build)
build-output/
