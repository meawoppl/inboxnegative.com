# Database configuration
DATABASE_URL=postgresql://username:password@hostname/dbname?sslmode=require

# Hash salts. REQUIRED -- the server refuses to start without both, on purpose.
# There is no default: a missing or altered salt does not error, it silently
# computes different hashes and orphans every existing address and stats row.
# EMAIL_SALT derives public burner addresses; DELETED_SALT derives the
# email_stats.email_hash primary key. Once live, these values must never change.
EMAIL_SALT=your-email-salt
DELETED_SALT=your-deleted-salt

# SMTP server configuration
SMTP_HOST=0.0.0.0
SMTP_PORT=2525

# HTTP server configuration
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
INBOXNULL_HOSTNAME=https://inboxnegative.com

# Google OAuth configuration
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Path to the stats file (for migration)
STATS_PATH=email_stats.json

# Testing mode (bypasses authentication)
# TESTING_MODE=false